# Environment variables template.
# Copy this file to .env.local to set your local values; .env.local is never versioned.

# Hosted PostgreSQL database (Neon). In production, both variables are added
# automatically by the Neon integration of Vercel.
# Leave them empty locally: PGlite is used automatically (.data/ directory).
DATABASE_URL=
# Direct connection (no pooling), used to apply migrations.
DATABASE_URL_UNPOOLED=

# Maximum number of connections opened by an application instance (5 by default).
DB_POOL_MAX=

# Session signing secret: required in production.
# Generate it with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public address of the application. Optional: inferred automatically on Vercel,
# and http://localhost:3000 locally.
BETTER_AUTH_URL=

# Turns off authentication rate limiting, locally only.
# AUTH_RATE_LIMIT=off

# Secret of the scheduled task dispatching the outbox: required in production.
# Vercel sends it in the Authorization header. Generate it with: openssl rand -base64 32
CRON_SECRET=

# Maximum duration of a real-time stream, in seconds (240 by default).
# STREAM_MAX_SECONDS=10
