# Environment variables template.
# Copy this file to .env.local to set your local values; .env.local is never versioned.

# Hosted PostgreSQL database (production).
# Leave empty locally: PGlite is used automatically (.data/ directory).
DATABASE_URL=

# Session signing secret: required in production.
# Generate it with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public address of the application (http://localhost:3000 by default).
BETTER_AUTH_URL=

# Turns off authentication rate limiting, locally only.
# AUTH_RATE_LIMIT=off
